AGENT_API_KEY=replace-with-a-long-random-key
# The Codex harness uses these values when calling the Notion MCP server.
NOTION_MCP_URL=
NOTION_WORKSPACE_IDS=

# Optional one-time PostgreSQL source used by backend-migrate. The desktop app
# itself does not connect to PostgreSQL.
DATABASE_URL=postgres://user:password@localhost:5432/recall

# Local development overrides. The packaged app chooses its own app-data path.
RECALL_DB_PATH=./.data/recall.sqlite3
RECALL_DB_BRIDGE=../backend-native/target/debug/recall-native-db
