{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recall",
  "version": "0.1.0",
  "identifier": "com.decimozs.recall",
  "build": {
    "beforeDevCommand": "sh scripts/dev.sh",
    "beforeBuildCommand": "sh scripts/build-frontend.sh",
    "devUrl": "http://localhost:4173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Recall",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": ["icons/icon.icns"],
    "externalBin": ["binaries/recall-backend", "binaries/recall-native-db"]
  }
}
